    invalid("n_structure_trailing_#.json", Json.Json.parse("{\"a\":\"b\"}#{}"))
    invalid("n_structure_uescaped_LF_before_string.json", Json.Json.parse("[\\u000A\"\"]"))
    invalid("n_structure_unclosed_array.json", Json.Json.parse("[1"))
    invalid("n_structure_unclosed_array_partial_null.json", Json.Json.parse("[ false, nul"))
    invalid("n_structure_unclosed_array_unfinished_false.json", Json.Json.parse("[ true, fals"))
    invalid("n_structure_unclosed_array_unfinished_true.json", Json.Json.parse("[ false, tru"))
    invalid("n_structure_unclosed_object.json", Json.Json.parse("{\"asd\":\"asd\""))
    invalid("n_structure_unicode-identifier.json", Json.Json.parse("\u{E5}"))
    invalid("n_structure_whitespace_U+2060_word_joiner.json", Json.Json.parse("[\u{2060}]"))
    invalid("n_structure_whitespace_formfeed.json", Json.Json.parse("[\u{C}]"))
    IO.print("JSONTestSuite: 93 valid and 174 invalid cases passed")
