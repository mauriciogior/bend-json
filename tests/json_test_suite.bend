import Base
import ../main.bend as Json

def valid(name: String, got: Result<&2, &2, Json.JsonError, Json.Json>) -> IO(Unit):
  match got:
    case Done{value}: IO.pure(Unit, Unit{})
    case Fail{error}: IO.die(Unit, 1, "expected valid: " ++ name)

def invalid(name: String, got: Result<&2, &2, Json.JsonError, Json.Json>) -> IO(Unit):
  match got:
    case Fail{error}: IO.pure(Unit, Unit{})
    case Done{value}: IO.die(Unit, 1, "expected invalid: " ++ name)

